{
  "name": "mrrinka-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:recess && npm run build:exports && next dev --hostname 127.0.0.1",
    "build": "npm run build:recess && npm run build:exports && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
