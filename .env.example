# Exact origin used for sign-in. Update when moving to your custom domain.
SITE_URL=http://localhost:3000
# Register a GitHub OAuth app with callback: SITE_URL/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Restrict the editor to this GitHub account's stable numeric ID.
ADMIN_GITHUB_ID=264626020
CONTENT_REPOSITORY=jrinka/mrrinka
CONTENT_BRANCH=main

# Cloudflare R2: server-only, bucket-scoped Object Read & Write credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mrrinka-resources
R2_PUBLIC_URL=https://resources.mrrinka.com
